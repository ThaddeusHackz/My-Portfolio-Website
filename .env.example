# ══════════════════════════════════════════════════════════════════════════
# THADDEUS TAGOE — PORTFOLIO · server-side secrets only
# Copy to `.env.local` for local development. NEVER commit real keys.
# NEVER put secrets in NEXT_PUBLIC_* variables.
# ══════════════════════════════════════════════════════════════════════════

# ─── AI AGENT (single key → automatic multi-model fallback) ──────────────
# One OpenRouter key drives the whole agent. The server walks a fallback
# chain (OpenAI → Gemini → Claude → DeepSeek → Llama → free models → auto)
# in groups of 3 and degrades to a local knowledge base when offline.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_HTTP_REFERER=https://thaddeus-portfolio.onrender.com
OPENROUTER_APP_TITLE=THADDEUS TAGOE PORTFOLIO
# Optional: comma-separated extra model slugs tried first (max 3 per request).
OPENROUTER_MODELS=

# ─── ADMIN PANEL (change after first login) ──────────────────────────────
ADMIN_EMAIL=admin@thaddeustagoe.dev
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Thaddeus Tagoe
SESSION_SECRET=change-this-long-random-string

# ─── Durable archive (optional) ──────────────────────────────────────────
# Without DATABASE_URL the site stores everything in ./data/db.json
# (ephemeral on Render free tier). Add the managed Postgres from render.yaml
# to survive restarts/deploys.
DATABASE_URL=

# ─── Public site URL (safe to expose) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
